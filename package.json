{
  "name": "ledger-api-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Database testing on our own money service: a Fastify + PostgreSQL Ledger API, a fresh Testcontainers database per worker, atomicity, idempotency, concurrency and ledger invariants. TypeScript + Playwright Test + Allure, GitHub Actions.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "ledger:dev": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/ledger-api/src/server.mts",
    "test:ledger": "playwright test --project=ledger",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "node scripts/allure-prepare.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "fastify": "5.12.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "testcontainers": "12.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.7"
  }
}
