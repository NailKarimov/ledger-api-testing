{
  "name": "api-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "API test automation for public REST APIs (OpenWeather, Swagger Petstore): contract validation, CRUD lifecycle, boundary values, negative testing, property-based fuzzing (Schemathesis). Playwright + TypeScript + zod + Allure.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:openweather": "playwright test --project=openweather",
    "test:petstore": "playwright test --project=petstore",
    "test:security": "playwright test --project=security",
    "ledger:dev": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/ledger-api/src/server.mts",
    "test:ledger": "playwright test --project=ledger",
    "test:graphql": "playwright test --project=graphql",
    "test:contract": "playwright test --project=contract-consumer --project=contract-provider",
    "test:sockshop": "playwright test --project=sockshop --project=sockshop-chaos --project=sockshop-events",
    "loadtest:smoke": "node scripts/run-k6.mjs catalogue-browse smoke",
    "loadtest:load": "node scripts/run-k6.mjs catalogue-browse load",
    "loadtest:stress": "node scripts/run-k6.mjs catalogue-browse stress",
    "loadtest:checkout": "node scripts/run-k6.mjs checkout load",
    "fuzz:up": "docker compose -f infra/petstore/docker-compose.yml up -d --wait",
    "fuzz": "st --config-file fuzz/schemathesis.toml run http://localhost:8090/api/v3/openapi.json --wait-for-schema 60",
    "fuzz:baseline": "npm run fuzz -- --baseline-update",
    "fuzz:down": "docker compose -f infra/petstore/docker-compose.yml down -v",
    "contract:check": "oasdiff breaking contracts/petstore/openapi.yaml http://localhost:8090/api/v3/openapi.json --fail-on ERR",
    "contract:changelog": "oasdiff changelog contracts/petstore/openapi.yaml http://localhost:8090/api/v3/openapi.json",
    "contract:selftest": "oasdiff breaking contracts/petstore/openapi.yaml contracts/petstore/fixtures/v2-breaking.yaml --format singleline",
    "stack:up": "docker compose -f infra/sock-shop/docker-compose.yml up -d && node scripts/wait-for-stack.mjs",
    "stack:down": "docker compose -f infra/sock-shop/docker-compose.yml down -v",
    "stack:wait": "node scripts/wait-for-stack.mjs",
    "stack:purge": "docker compose -f infra/sock-shop/docker-compose.yml down -v --rmi all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "node scripts/allure-prepare.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-inspector/core": "8.0.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "amqplib": "^0.10.8",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "fastify": "5.12.5",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "testcontainers": "12.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.7"
  }
}
